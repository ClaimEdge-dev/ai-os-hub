{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "version",
    "entity_scope",
    "mode",
    "target_url",
    "timeout_ms",
    "allowed_extract_selectors"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{3,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entity_scope": {
      "type": "string",
      "minLength": 2
    },
    "mode": {
      "enum": [
        "read_only",
        "interactive_write"
      ]
    },
    "target_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 500,
      "maximum": 15000
    },
    "requires_write_token": {
      "type": "boolean"
    },
    "allowed_extract_selectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allowed_path_prefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/",
        "maxLength": 128
      }
    },
    "allow_query_params": {
      "type": "boolean"
    },
    "allowed_query_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "interactive_write"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "requires_write_token"
        ],
        "properties": {
          "requires_write_token": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "read_only"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "allowed_path_prefixes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "allow_query_params": {
            "const": true
          }
        },
        "required": [
          "allow_query_params"
        ]
      },
      "then": {
        "required": [
          "allowed_query_keys"
        ]
      }
    }
  ]
}
